# Backend environment variables (safe defaults for local/preview usage)

# JWT secret for signing tokens. For production, override with a strong random string.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240

# SQLite database path (auto-created). If a resident_db dependency is present in your environment,
# the app will still work with this local DB fallback.
SQLITE_DB_PATH=/home/kavia/workspace/code-generation/resident-management-system-199871-199881/resident_api_backend/residents.db

# Where uploaded photos are stored on disk (served at /uploads)
UPLOAD_DIR=/home/kavia/workspace/code-generation/resident-management-system-199871-199881/resident_api_backend/uploads

# CORS
FRONTEND_ORIGIN=http://localhost:3000
